# Together AI API Key
TOGETHER_API_KEY=tu_api_key_aqui

# Configuración del servidor TCP del Agente
AUDIO_TCP_HOST=127.0.0.1
AUDIO_TCP_PORT=8080

# Modelos Together AI
STT_MODEL=openai/whisper-large-v3
LLM_MODEL=Qwen/Qwen3.5-9B
TTS_MODEL=hexgrad/Kokoro-82M

# Voz en español de Kokoro (ef_dora = femenina español)
TTS_VOICE=ef_dora

# Desactiva el modo de razonamiento / CoT para responder con mínima latencia sin pensar internamente
DISABLE_REASONING=true

# Límite estricto de tokens de respuesta (90 tokens ≈ 1-2 frases cortas)
LLM_MAX_TOKENS=90

# Configuración de audio telefónico
AUDIO_SAMPLE_RATE=16000

# Parámetros Silero VAD
VAD_SPEECH_THRESHOLD=0.60
VAD_SILENCE_THRESHOLD=0.35
VAD_SILENCE_TIMEOUT_MS=500
BARGE_IN_THRESHOLD=0.85
BARGE_IN_CONSECUTIVE_FRAMES=3

# Prompt comercial completo de prospección web y autorización para WhatsApp
SYSTEM_PROMPT="Eres Juan, asesor comercial de diseño y desarrollo web para negocios locales. Tu objetivo es ofrecer amablemente la preparación de una muestra previa gratuita de una página web para su negocio y conseguir su autorización explícita para enviársela por WhatsApp al número al que estamos llamando. Instrucciones estrictas: 1. Responde SIEMPRE en un máximo de 1 o 2 oraciones breves y conversacionales (menos de 25 palabras). Nunca uses listas ni viñetas. 2. Oferta: Ofrecemos prepararte una muestra gratuita sin ningún compromiso. 3. Precios: Si preguntan precio directamente, di que la instalación son 99 euros y luego 5 o 10 euros al mes según el plan, pero que primero le preparamos la muestra gratuita para que la valore. 4. Si dicen que no tienen tiempo, di que por eso se la mandas por WhatsApp y la mira en 1 minuto cuando pueda. 5. Si ya tienen web, ofrece enviar una comparativa moderna para captar más clientes en móvil. 6. Cuando el cliente diga que sí o acepte, confirma amablemente: 'Perfecto, te la preparo y te la envío a este mismo WhatsApp. ¡Muchas gracias y que tengas buen día!' y finaliza."

# Motor de Conversación (together_pipeline | openai_realtime)
CONVERSATION_ENGINE=together_pipeline

# OpenAI Realtime (Doble Asistente Comercial y Técnico)
OPENAI_API_KEY=tu_openai_api_key_aqui
REALTIME_COMMERCIAL_MODEL=gpt-realtime-2.1-mini
REALTIME_COMMERCIAL_VOICE=marin
REALTIME_TECHNICAL_MODEL=gpt-realtime-2.1
REALTIME_TECHNICAL_VOICE=cedar
REALTIME_TURN_DETECTION=semantic_vad
HANDOFF_ENABLED=true
HANDOFF_TIMEOUT_MS=8000
CALL_COST_ALERT_USD=0.10
CALL_COST_SOFT_LIMIT_USD=0.20
CALL_COST_HARD_LIMIT_USD=0.30
