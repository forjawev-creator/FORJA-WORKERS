{
  "name": "forja-workers",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "voice": "tsx src/voice-entry.ts",
    "business": "tsx src/business-entry.ts",
    "start:all": "tsx src/index.ts",
    "start:monolith": "tsx src/index.ts",
    "start:voice": "tsx src/voice-entry.ts",
    "start:bridge": "python bridge/netelip-bridge.py",
    "start:crm": "tsx src/crm-web-entry.ts",
    "start:whatsapp": "tsx src/whatsapp-entry.ts",
    "check": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:isolation": "tsx scripts/verify-voice-isolation.ts",
    "test:regression": "tsx scripts/test-regression-suite.ts",
    "test:bridge": "python scripts/test-bridge-http.py",
    "test:resilience": "tsx scripts/test-service-resilience.ts",
    "test:workers": "node --test scripts/test-workers-safe.cjs scripts/test-storage-windows.cjs",
    "test:all": "npm run check && npm run test:isolation && npm run test:bridge && npm run test:resilience && npm run test:regression",
    "test:client": "tsx scripts/mock-caller.ts",
    "bridge": "python bridge/netelip-bridge.py",
    "test": "npm run test:workers && npm run test:pilot && npm run test:bridge:stabilization && npm run test:backup && npm run test:inbound",
    "start:pilot": "node dist/pilot-entry.js",
    "test:pilot": "node --test scripts/test-pilot-safe.cjs scripts/test-pilot-http-safe.cjs scripts/test-voice-lifecycle-safe.cjs scripts/test-gemini-consent-safe.cjs",
    "test:bridge:stabilization": "python scripts/test-bridge-stabilization.py && python scripts/test-bridge-logging.py && node --import tsx --test scripts/test-bridge-supervisor.ts",
    "test:backup": "python scripts/test-pilot-backup.py",
    "start:inbound": "node dist/inbound-entry.js",
    "test:inbound": "python scripts/test-inbound-routing.py && python scripts/test-inbound-service.py && node --import tsx --test scripts/test-inbound-controller.ts && node --test scripts/test-secretary-engine.cjs && node --import tsx --test scripts/test-inbound-http.ts"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.5",
    "onnxruntime-node": "^1.18.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "private": true
}
